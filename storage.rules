rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function active() { return request.auth != null && request.auth.token.email_verified == true && (!firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('suspended', false) == false) && (request.auth.token.get('admin', false) == true || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('eligible', false) == true); }
    function admin() { return active() && request.auth.token.get('admin', false) == true && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('adminEnabled', false) == true; }
    function validImage() { return request.resource.size < 4 * 1024 * 1024 && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'] && !('firebaseStorageDownloadTokens' in request.resource.metadata); }
    match /photos/{uid}/{fileName} {
      allow read: if active();
      allow create: if active() && request.auth.uid == uid && validImage();
      allow update, delete: if false;
    }
    match /evidence/{uid}/{claimId}/{fileName} {
      allow read: if active() && (request.auth.uid == uid || admin());
      allow create: if active() && request.auth.uid == uid && validImage()
        && firestore.get(/databases/(default)/documents/claims/$(claimId)).data.claimantId == uid
        && firestore.get(/databases/(default)/documents/claims/$(claimId)).data.state in ['submitted', 'under_review', 'needs_information'];
      allow update, delete: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
