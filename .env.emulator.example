# Copy these values into .env.local only for isolated local development.
EXPO_PUBLIC_FIREBASE_API_KEY=demo-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-legon-recovery.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-legon-recovery
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-legon-recovery.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
EXPO_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:demo
EXPO_PUBLIC_USE_EMULATORS=true
# Android emulator: change to 10.0.2.2. iOS simulator: 127.0.0.1.
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
