# Firebase Configuration Credentials
# Copy this file to a new file named '.env' and fill in your actual credentials from the Firebase Console.
# Modern Expo exposes any environment variables starting with 'EXPO_PUBLIC_' to the application bundle.

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
# Newer Firebase projects use <project-id>.firebasestorage.app; older ones use <project-id>.appspot.com.
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# Local emulators only; leave false for the live Firebase project.
EXPO_PUBLIC_USE_EMULATORS=false
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
