rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // A user's own profile document. Written once at sign-up.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(uid)
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
      allow list: if false;
    }

    // Lost and found posts. Readable by any signed-in user, writable only by
    // the account that created them.
    match /items/{itemId} {
      function validItem(data) {
        return data.title is string && data.title.size() > 0 && data.title.size() <= 60
               && data.description is string && data.description.size() > 0
               && data.location is string && data.location.size() > 0
               && data.status in ['lost', 'found']
               && data.category in ['Phone', 'Wallet', 'ID Card', 'Bag', 'Keys', 'Others'];
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.authorEmail == request.auth.token.email
                    && request.resource.data.createdAt == request.time
                    && validItem(request.resource.data);
      allow update: if isOwner(resource.data.authorId)
                    && request.resource.data.authorId == resource.data.authorId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && validItem(request.resource.data);
      allow delete: if isOwner(resource.data.authorId);
    }

    // Bookmarks. Each document is private to the user who created it.
    match /savedItems/{savedId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.itemId is string;
      allow update: if false;
      allow delete: if isOwner(resource.data.userId);
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
